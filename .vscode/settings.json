{
  // ESLint lives in web/: underline errors (red) and warnings (yellow) in JS and Svelte files.
  "eslint.workingDirectories": ["web"],
  "eslint.validate": ["javascript", "svelte"],
  "eslint.run": "onType",

  // Format with Prettier, which follows .editorconfig and web/.prettierrc.json.
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "prettier.prettierPath": "web/node_modules/prettier",
  "[svelte]": { "editor.defaultFormatter": "svelte.svelte-vscode" },
  // C# formatting comes from the C# extension and .editorconfig.
  "[csharp]": { "editor.defaultFormatter": "muhammad-sammy.csharp" },
  "editor.codeActionsOnSave": { "source.fixAll.eslint": "explicit" }
}

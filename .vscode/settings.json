{
  // ESLint lives in web/ and packages/core: underline errors (red) and warnings (yellow) in JS, TS and Svelte files.
  "eslint.workingDirectories": ["web", "packages/core"],
  "eslint.validate": ["javascript", "typescript", "svelte"],
  "eslint.run": "onType",

  // Format with Prettier, which follows .editorconfig and each package's .prettierrc.
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "prettier.prettierPath": "node_modules/prettier",
  "[svelte]": { "editor.defaultFormatter": "svelte.svelte-vscode" },
  // C# formatting comes from the C# extension and .editorconfig.
  "[csharp]": { "editor.defaultFormatter": "muhammad-sammy.csharp" },
  "editor.codeActionsOnSave": { "source.fixAll.eslint": "explicit" }
}

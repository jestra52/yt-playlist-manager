# EditorConfig: https://editorconfig.org
# Shared formatting for the Svelte web app (modern ECMAScript modules,
# Svelte 5 components, Sass) and the Go sync API in the same repository.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# JavaScript (ES modules), Svelte components and runes modules (*.svelte.js)
[*.{js,mjs,cjs,svelte}]
quote_type = single
max_line_length = 120

# Styles: Tailwind entry (CSS) and Sass partials/components
[*.{css,scss}]
quote_type = single
max_line_length = 120

[*.{html,json,yml,yaml,toml}]
indent_size = 2

# Markdown uses two trailing spaces as a line break
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# Go sources follow gofmt (tabs)
[{*.go,go.mod,go.sum}]
indent_style = tab
indent_size = 4

# Netlify _headers: indentation is meaningful, keep it as written
[web/public/_headers]
indent_size = 2

# Local settings for the web app. Copy this file to web/.env and adjust it:
#   cp .env.example .env
# web/.env is git-ignored. Vite reads it for `npm run dev` and `npm run preview`.
# Only VITE_* variables would reach the browser bundle; these stay in the dev server.

# Where the dev server forwards /api. Defaults to the local .NET API.
API_URL=http://localhost:8787

# To try the app against the deployed API instead:
# API_URL=<yt-playlist-manager-api-uri>

<Project Sdk="Microsoft.NET.Sdk">
  <!-- Adapters: Entity Framework Core on PostgreSQL, and HTTP clients for YouTube. -->
  <ItemGroup>
    <ProjectReference Include="..\YtPlaylist.Application\YtPlaylist.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <!-- Needed by `dotnet ef` to create migrations; not shipped with the app. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="YtPlaylist.Tests" />
  </ItemGroup>
</Project>

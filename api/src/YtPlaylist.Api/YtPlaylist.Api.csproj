<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- HTTP layer: minimal API endpoints, auth and CORS. -->
  <PropertyGroup>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Local settings can hold secrets: read from the project folder by `dotnet run`, never
         copied to the build output or published (so never in the Docker image either). -->
    <Content Update="appsettings.Local*.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\YtPlaylist.Models\YtPlaylist.Models.csproj" />
    <ProjectReference Include="..\YtPlaylist.Application\YtPlaylist.Application.csproj" />
    <ProjectReference Include="..\YtPlaylist.Infrastructure\YtPlaylist.Infrastructure.csproj" />
  </ItemGroup>
</Project>

# Local settings for the API. Copy this file to api/.env and fill it in:
#   cp .env.example .env
# api/.env is git-ignored, so keys and passwords put there are never committed.
# It is only read when the API runs in Development (`dotnet run`); Render and other
# hosts set these as real environment variables, which always take precedence.

# PostgreSQL for sync. Matches the database from `docker compose up -d` in api/.
# Leave empty to run without sync (video titles and playlist imports still work).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ytplaylist

# Token the web app sends to /api/sync. Enter the same value in the app's sync settings.
SYNC_TOKEN=dev-token

# Optional. YouTube Data API v3 key: playlist imports read the whole playlist
# instead of the first 15 videos. Google Cloud Console -> Credentials -> API key.
YOUTUBE_API_KEY=

# Optional. Comma-separated origins allowed to call the API directly (CORS).
# Empty allows any origin; the Vite dev server proxies /api, so it isn't needed locally.
ALLOWED_ORIGIN=
